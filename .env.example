# Copied by Compose for variable substitution (docker compose up).
#   cp .env.example .env
#
# --- Official TradeLens prebuilt images ---
TM_IMAGE_REGISTRY=ghcr.io/hoesenbruce
# Production: pin a stable version. Compose without this setting uses moving latest.
TM_IMAGE_TAG=0.2.1

# --- App (same keys as docker-compose.yml) ---
# TM_JWT_SECRET=          # openssl rand -hex 32  (required in production)
# TM_ALLOW_INSECURE_JWT=false
# TM_ALLOW_REGISTRATION=false
# TM_DATABASE_URL=sqlite:///data/tradermemos.db
# TM_CORS_ORIGINS=

# --- Database backups (SQLite) -----------------------------------------------
# Daily VACUUM INTO snapshots named tradelens-YYYYMMDD-HHMMSS.NNNNNNNNNZ-<random>.db; the newest
# TM_BACKUP_KEEP are kept. Sync TM_BACKUP_DIR off-site yourself (docs/deploy.md).
# TM_BACKUP_ENABLED=true
# TM_BACKUP_DIR=/data/backups
# TM_BACKUP_KEEP=14
# TM_BACKUP_INTERVAL_MIN=1440

# --- Public share pages -----------------------------------------------------
# Revocable read-only performance links (/s/<token>). Off by default: the
# public endpoint exposes journal aggregates without auth.
# TM_SHARE_LINKS_ENABLED=false
# Public web-app origin used in share links shown to API clients (mobile).
# Leave unset when the same origin serves both the web app and /api.
# TM_PUBLIC_WEB_URL=https://tm.example.com

# --- Economic calendar (ForexFactory feed, on by default) ---
# TM_ECON_CALENDAR_ENABLED=true
# TM_ECON_CALENDAR_FEED_URL=       # override the FairEconomy feed URL
# TM_ECON_CALENDAR_REFRESH_MIN=60  # feed cache TTL in minutes
